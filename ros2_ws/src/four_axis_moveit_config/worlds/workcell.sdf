<?xml version="1.0"?>
<sdf version="1.8">

  <world name="workcell">

    <!-- Physics -->
    <physics name="physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Scene -->
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.8 0.8 0.8 1</background>
    </scene>

    <!-- Sun -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -1</direction>
    </light>

    <!-- Floor -->
    <model name="floor">
      <static>true</static>

      <pose>0 0 -0.05 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>6 6 0.1</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>6 6 0.1</size>
            </box>
          </geometry>

          <material>
            <ambient>0.75 0.75 0.75 0.75</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
          </material>

        </visual>

      </link>
    </model>

    <!-- Workbench -->
    <model name="workbench">
      <static>true</static>

      <!-- Center of an 0.8 m tall table -->
      <pose>0 0 0.4 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>1.2 0.8 0.8</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>1.2 0.8 0.8</size>
            </box>
          </geometry>

          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>

        </visual>

      </link>
    </model>

  </world>

</sdf>